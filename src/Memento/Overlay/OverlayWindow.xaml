<ui:FluentWindow x:Class="Memento.Overlay.OverlayWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:behaviors="clr-namespace:Memento.Overlay.Behaviors"
                 xmlns:enums="clr-namespace:Memento.Enumerations"
                 xmlns:taskmodels="clr-namespace:Memento.Overlay.Tasks.Models"
                 xmlns:taskviewmodels="clr-namespace:Memento.Overlay.Tasks.ViewModels"
                 Title="Memento"
                 Width="680"
                 SizeToContent="Height"
                 MinWidth="0"
                 MinHeight="0"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 PreviewKeyDown="Window_PreviewKeyDown"
                 Deactivated="Window_Deactivated">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="KeyChip" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Hint text that takes no space while empty ("Add a title"). -->
        <Style x:Key="OptionalHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Inline storage error: like the optional hint, in the critical colour, trimmed to the space left. -->
        <Style x:Key="ErrorHintText" TargetType="TextBlock" BasedOn="{StaticResource OptionalHintText}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TaskTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Selected row: subtle fill with an accent bar on the left (like WinUI 3 lists). -->
        <Style x:Key="TaskRowStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="4" Background="Transparent">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- WinUI: a selected row under the pointer is one step darker than selected or hovered alone. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TaskTemplate" DataType="{x:Type taskviewmodels:TaskRowViewModel}">
            <!-- Fixed 40 px (WinUI ListViewItem height), so swapping the title for the editor never changes the row height. -->
            <Grid Height="40" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Circle16" FontSize="14" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="TitleLabel" Grid.Column="1" Style="{StaticResource TaskTitle}"
                           Text="{Binding Title}" ToolTip="{Binding Title}" />
                <!-- Inline editor (F2): shown instead of the title while the row is being edited. -->
                <ui:TextBox Grid.Column="1" Height="32" MinHeight="0" Margin="0" Padding="8,0"
                            VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="14"
                            AutomationProperties.Name="Task title"
                            SpellCheck.IsEnabled="False"
                            Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                            behaviors:FocusBehavior.IsFocused="{Binding IsEditing}"
                            LostKeyboardFocus="TitleEditor_LostKeyboardFocus" />
                <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Margin="12,0,0,0"
                           Text="{Binding TagsText}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="DeadlineLabel" Grid.Column="3" Style="{StaticResource HintText}" Margin="16,0,0,0"
                           Text="{Binding DeadlineText}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="DeadlineLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="TitleLabel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="BadgeTemplate" DataType="{x:Type taskmodels:PreviewBadge}">
            <Border Style="{StaticResource KeyChip}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon x:Name="BadgeIcon" Symbol="Calendar16" FontSize="12" Margin="0,0,5,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Text}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static enums:PreviewBadgeKind.Tag}">
                    <Setter TargetName="BadgeIcon" Property="Symbol" Value="Tag16" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <StackPanel>
        <!-- Input bar: stock WinUI 3 TextBox (rounded border, subtle fill, accent underline on focus) -->
        <Grid Margin="12">
            <ui:TextBox x:Name="InputBox"
                        FocusVisualStyle="{x:Null}"
                        AutomationProperties.Name="New task"
                        PlaceholderText="What do you want to remember?  e.g. call Anna tomorrow 3pm #work"
                        ClearButtonEnabled="True"
                        AcceptsReturn="False"
                        SpellCheck.IsEnabled="False"
                        Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Add20" />
                </ui:TextBox.Icon>
            </ui:TextBox>
        </Grid>

        <!-- Task list -->
        <StackPanel Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Padding="0,4">
                <ListBox x:Name="TaskList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Focusable="False"
                         AutomationProperties.Name="Open tasks"
                         SelectionMode="Single"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Tasks}"
                         SelectedIndex="{Binding SelectedIndex}"
                         ItemTemplate="{StaticResource TaskTemplate}"
                         ItemContainerStyle="{StaticResource TaskRowStyle}"
                         SelectionChanged="TaskList_SelectionChanged" />
            </ScrollViewer>
        </StackPanel>

        <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!-- Hint bar -->
        <Grid Height="40" Margin="8,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Last stop of the keyboard list (input, tasks, Settings); Enter/Space opens it. -->
            <ui:Button x:Name="SettingsButton"
                       Grid.Column="0"
                       Height="32"
                       Padding="8,0"
                       Appearance="Transparent"
                       ToolTip="Settings"
                       AutomationProperties.Name="Settings"
                       Click="SettingsButton_Click"
                       GotKeyboardFocus="SettingsButton_FocusChanged"
                       LostKeyboardFocus="SettingsButton_FocusChanged">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Settings20" FontSize="16" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource HintText}" Text="Settings" />
                </StackPanel>
            </ui:Button>

            <!-- Live preview: what the parser read from the line being typed or edited;
                 then, filling the rest, why the last save failed (inline: a dialog would hide the overlay). -->
            <DockPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource OptionalHintText}" Text="{Binding PreviewHint}" />
                    <ItemsControl ItemsSource="{Binding Preview}" ItemTemplate="{StaticResource BadgeTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Style="{StaticResource ErrorHintText}"
                           Text="{Binding ErrorText}"
                           ToolTip="{Binding ErrorText}" />
            </DockPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource KeyChip}">
                    <TextBlock Style="{StaticResource HintText}" Text="↑↓" />
                </Border>
                <TextBlock Style="{StaticResource HintText}" Margin="6,0,16,0" Text="select" />
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ShowEditHint, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource KeyChip}">
                        <TextBlock Style="{StaticResource HintText}" Text="F2" />
                    </Border>
                    <TextBlock Style="{StaticResource HintText}" Margin="6,0,16,0" Text="edit" />
                </StackPanel>
                <Border Style="{StaticResource KeyChip}">
                    <TextBlock Style="{StaticResource HintText}" Text="Enter" />
                </Border>
                <TextBlock Style="{StaticResource HintText}" Margin="6,0,16,0" Text="{Binding EnterHint}" />
                <Border Style="{StaticResource KeyChip}">
                    <TextBlock Style="{StaticResource HintText}" Text="Esc" />
                </Border>
                <TextBlock Style="{StaticResource HintText}" Margin="6,0,0,0" Text="{Binding EscapeHint}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</ui:FluentWindow>
