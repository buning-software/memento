<ui:FluentWindow x:Class="Memento.Settings.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:core="clr-namespace:Memento.Core.Enumerations;assembly=Memento.Core"
                 xmlns:controls="clr-namespace:Memento.Settings.Controls"
                 Title="Memento settings"
                 AutomationProperties.AutomationId="SettingsWindow"
                 Width="1200"
                 Height="880"
                 MinWidth="600"
                 MinHeight="400"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="Window_KeyDown">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- SettingHeader, SettingDescription, SettingError -->
                <ResourceDictionary Source="Controls/SettingTextStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Section header (BodyStrong). -->
            <Style x:Key="SectionHeader" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="BodyStrong" />
                <Setter Property="Margin" Value="1,24,0,8" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings20" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Single scrollable column with a constrained maximum width. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,0,36,36" MaxWidth="1000">

                <ui:TextBlock FontTypography="Title" Margin="0,8,0,0" Text="Settings" />

                <!-- General -->
                <ui:TextBlock Style="{StaticResource SectionHeader}" Margin="1,20,0,8" Text="General" />

                <controls:SettingCard Icon="Keyboard24"
                                      Header="Capture shortcut"
                                      Description="Opens Memento from anywhere. Select the button, then press the new combination.">
                    <controls:SettingCard.Details>
                        <TextBlock Style="{StaticResource SettingError}" Text="{Binding ShortcutError}" />
                    </controls:SettingCard.Details>
                    <!-- No x:Name: WPF does not allow named elements inside a UserControl's content (MC3093). -->
                    <ui:Button MinWidth="160"
                               AutomationProperties.AutomationId="ShortcutButton"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Content="{Binding ShortcutText}"
                               Click="ShortcutButton_Click"
                               PreviewKeyDown="ShortcutButton_PreviewKeyDown"
                               LostKeyboardFocus="ShortcutButton_LostKeyboardFocus" />
                </controls:SettingCard>

                <controls:SettingCard Icon="Rocket24"
                                      Header="Start with Windows"
                                      Description="{Binding AutostartDescription}">
                    <ui:ToggleSwitch AutomationProperties.AutomationId="StartWithWindowsToggle"
                                     Margin="16,0,0,0"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding StartWithWindows}"
                                     IsEnabled="{Binding IsAutostartAvailable}" />
                </controls:SettingCard>

                <controls:SettingCard Icon="Desktop24"
                                      Header="Show on"
                                      Description="Which monitor the capture window appears on.">
                    <ComboBox AutomationProperties.AutomationId="MonitorComboBox"
                              MinWidth="200"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding Monitor}">
                        <ComboBoxItem Content="Primary monitor" Tag="{x:Static core:OverlayMonitor.Primary}" />
                        <ComboBoxItem Content="Monitor with the mouse" Tag="{x:Static core:OverlayMonitor.Cursor}" />
                    </ComboBox>
                </controls:SettingCard>

                <controls:SettingCard Icon="Clock24"
                                      Header="Default deadline time"
                                      Description="Used when a deadline has a date but no time, such as &quot;tomorrow&quot; or &quot;friday&quot;.">
                    <ComboBox AutomationProperties.AutomationId="DefaultTimeComboBox"
                              MinWidth="200"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding DefaultTimeOptions}"
                              SelectedItem="{Binding DefaultTime}"
                              ItemStringFormat="HH:mm" />
                </controls:SettingCard>

                <!-- Reminders -->
                <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Reminders" />

                <controls:SettingCard Icon="Alert24"
                                      Header="Deadline reminders"
                                      Description="Show a Windows notification when a task's deadline is near.">
                    <ui:ToggleSwitch Margin="16,0,0,0"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding RemindersEnabled}" />
                </controls:SettingCard>

                <controls:SettingCard Icon="Timer24"
                                      Header="Remind me"
                                      Description="How long before the deadline the notification appears.">
                    <ComboBox MinWidth="200"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding ReminderLeadOptions}"
                              SelectedItem="{Binding ReminderLeadMinutes}"
                              IsEnabled="{Binding RemindersEnabled}"
                              ItemStringFormat="{}{0} minutes before" />
                </controls:SettingCard>

                <!-- Appearance -->
                <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />

                <controls:SettingCard Icon="PaintBrush24"
                                      Header="App theme"
                                      Description="Select which app theme to display.">
                    <controls:SettingCard.Details>
                        <ui:HyperlinkButton AutomationProperties.AutomationId="ColorSettingsLink"
                                            Padding="0"
                                            Margin="0,4,0,0"
                                            Content="Windows color settings"
                                            Command="{Binding OpenColorSettingsCommand}" />
                    </controls:SettingCard.Details>
                    <ComboBox AutomationProperties.AutomationId="ThemeComboBox"
                              MinWidth="200"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding Theme}">
                        <ComboBoxItem Content="Light" Tag="{x:Static core:AppTheme.Light}" />
                        <ComboBoxItem Content="Dark" Tag="{x:Static core:AppTheme.Dark}" />
                        <ComboBoxItem Content="Use system setting" Tag="{x:Static core:AppTheme.System}" />
                    </ComboBox>
                </controls:SettingCard>

                <!-- About -->
                <ui:TextBlock Style="{StaticResource SectionHeader}" Text="About" />

                <ui:CardExpander ContentPadding="0">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Info24" FontSize="20" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingHeader}" VerticalAlignment="Center" Text="Memento" />
                            <TextBlock Grid.Column="1" Style="{StaticResource SettingDescription}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding Version}" />
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel>
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingHeader}" Text="Your data" />
                                <TextBlock Style="{StaticResource SettingDescription}" Text="{Binding DataDirectory}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       AutomationProperties.AutomationId="OpenFolderButton"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Content="Open folder"
                                       Command="{Binding OpenDataFolderCommand}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Style="{StaticResource SettingDescription}" Margin="16,12"
                                   Text="Everything is stored on this device. Memento never sends your tasks anywhere." />
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
